# Environment Configuration - Ministry of Tribal Affairs (SIH 2026)
# AI-Enabled Scholarship & Fellowship Management System

PROJECT_NAME="AI-Enabled Scholarship & Fellowship Management System"
API_V1_STR="/api/v1"

# Environment Mode: 'development', 'demo', or 'production'
# In 'production', HSTS security headers are automatically activated.
ENVIRONMENT=demo
EXPECTED_ALEMBIC_HEAD=0008_phase8_fellowships

# Database Configuration (PostgreSQL 18 Only - No SQLite fallback)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loki_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loki_db

# Security & JWT Authentication
# In production, replace with a 64+ char random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=demo_secret_key_change_in_production_tribal_affairs_sih_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security Limits
MAX_REQUEST_BODY_BYTES=26214400 # 25 MB
RATE_LIMIT_LOGIN_PER_MINUTE=30

# File Storage (Pure UUID paths)
STORAGE_PATH=./storage

# CORS Settings (JSON array string or comma-separated)
# Explicit origin whitelist - wildcards are prohibited with credentials
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
